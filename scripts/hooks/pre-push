#!/usr/bin/env python3
"""Pre-push hook: verify cross-repo Python imports resolve against the push-target branch of sibling repos.

Catches the failure mode where a push to this repo introduces `from <sibling>.X import Y`
referencing a symbol that exists in the local working copy of the sibling but not yet on
the sibling's remote branch. Such pushes silently break CI (which checks out each repo at
its remote-tracked state) while passing local dev.

The branch compared against follows the push target (OPS-PREPUSH-HOOK-TARGET-BRANCH-1): a push to
`refs/heads/2.0` is checked against `origin/2.0` of this repo and of each sibling, a push to
`refs/heads/main` against `origin/main`. A target that is not a branch (a tag, no stdin) or a sibling
that has no such branch falls back to `origin/main` with one WARNING. Kill switch:
`PREPUSH_TARGET_BRANCH=0` restores the old always-`origin/main` behaviour.

A name counts as exported (OPS-PREPUSH-HOOK-DYNAMIC-EXPORTS-1) when the sibling module binds it (def, class,
assignment, `import`, `from m import x` re-export), lists it in `__all__`, answers it from a module `__getattr__`
that names it in a string literal (`if name == "x"`, `name in _LAZY`, `_LAZY[name]`), or star-imports it from a
module that exports it. A `__getattr__` or star import that cannot be read statically accepts the name with one
WARNING line saying so; a name no rule finds is still refused.

Usage: install via scripts/install-git-hooks.sh.
Skip with `git push --no-verify` (DO NOT make a habit of it).
"""

from __future__ import annotations

import ast
import os
import subprocess
import sys
from pathlib import Path

# Module-name prefix → sibling repo path relative to this repo's root.
SIBLING_REPOS = {
    "service_common": "../smart-memory-common",
    "smartmemory": "../smart-memory-core",
}

# Source dirs to inspect (production code; skip tests/scripts/venvs).
PRODUCTION_DIRS = ("memory_service", "smartmemory_mcp")
SKIP_PATH_PARTS = {
    "tests",
    "test",
    "scripts",
    ".git",
    "__pycache__",
    ".venv",
    "venv",
    "build",
    "dist",
}


def run(cmd: list[str], cwd: Path | None = None, check: bool = True) -> str:
    return subprocess.check_output(cmd, cwd=cwd, stderr=subprocess.DEVNULL).decode()


def repo_root() -> Path:
    return Path(run(["git", "rev-parse", "--show-toplevel"]).strip())


DEFAULT_BRANCH = "main"
ZERO_SHA = "0" * 40


def target_branches(stdin_text: str, warnings: list[str]) -> list[str]:
    """Branches this push updates, from the hook's stdin (`<local ref> <local sha> <remote ref> <remote sha>` per line).

    Deletes are skipped. A remote ref that is not `refs/heads/<name>`, or no usable stdin at all, resolves to
    `main` with one WARNING. `PREPUSH_TARGET_BRANCH=0` forces `["main"]` with no warning (old behaviour)."""
    if os.environ.get("PREPUSH_TARGET_BRANCH") == "0":
        return [DEFAULT_BRANCH]
    branches: list[str] = []
    unknown: list[str] = []
    for line in stdin_text.splitlines():
        parts = line.split()
        if len(parts) != 4 or set(parts[1]) == {"0"}:
            continue  # blank, malformed, or a delete (local sha all zeros)
        remote_ref = parts[2]
        if remote_ref.startswith("refs/heads/"):
            branch = remote_ref[len("refs/heads/") :]
        else:
            branch = DEFAULT_BRANCH
            unknown.append(remote_ref)
        if branch not in branches:
            branches.append(branch)
    if not branches and not stdin_text.strip():
        unknown.append("<no push target on stdin>")
        branches.append(DEFAULT_BRANCH)
    for ref in unknown:
        warnings.append(
            f"  push target {ref} is not a branch: comparing against origin/{DEFAULT_BRANCH}"
        )
    return branches


def read_stdin() -> str:
    try:
        return "" if sys.stdin is None or sys.stdin.isatty() else sys.stdin.read()
    except (OSError, ValueError):
        return ""


def has_remote_ref(repo: Path, ref: str) -> bool:
    try:
        run(
            [
                "git",
                "-C",
                str(repo),
                "rev-parse",
                "--verify",
                "--quiet",
                ref + "^{commit}",
            ]
        )
        return True
    except subprocess.CalledProcessError:
        return False


def own_base_ref(root: Path, branch: str, warnings: list[str]) -> str:
    """origin/<branch> of this repo if it exists locally, else origin/main with one WARNING."""
    ref = f"origin/{branch}"
    if branch == DEFAULT_BRANCH or has_remote_ref(root, ref):
        return ref
    warnings.append(
        f"  this repo has no {ref}: comparing new imports against origin/{DEFAULT_BRANCH}"
    )
    return f"origin/{DEFAULT_BRANCH}"


def files_changed_in_push(root: Path, base_ref: str = "origin/main") -> list[Path]:
    """Python files that differ between local HEAD and `base_ref`."""
    try:
        out = run(
            ["git", "diff", "--name-only", f"{base_ref}..HEAD", "--", "*.py"], cwd=root
        )
    except subprocess.CalledProcessError:
        return []
    paths = []
    for line in out.splitlines():
        p = root / line.strip()
        if any(part in SKIP_PATH_PARTS for part in p.parts):
            continue
        if PRODUCTION_DIRS and not any(part in PRODUCTION_DIRS for part in p.parts):
            continue
        if p.exists():
            paths.append(p)
    return paths


def imports_from_file(path: Path) -> list[tuple[str, str]]:
    try:
        tree = ast.parse(path.read_text())
    except (SyntaxError, UnicodeDecodeError):
        return []
    out = []
    for node in ast.walk(tree):
        if isinstance(node, ast.ImportFrom) and node.module and node.level == 0:
            for alias in node.names:
                if alias.name == "*":
                    continue  # wildcard imports can't be validated
                out.append((node.module, alias.name))
    return out


def _fetch(sibling: Path, branch: str) -> bool:
    try:
        run(["git", "-C", str(sibling), "fetch", "origin", branch, "--quiet"])
        return True
    except subprocess.CalledProcessError:
        return False


def fetch_origin(
    sibling: Path, branch: str = DEFAULT_BRANCH, warnings: list[str] | None = None
) -> str | None:
    """Fetch `branch` of the sibling's origin and return the ref to compare against: `origin/<branch>`, or
    `origin/main` with one WARNING when the sibling has no such branch. None when the remote is unreachable."""
    if _fetch(sibling, branch):
        return f"origin/{branch}"
    if branch != DEFAULT_BRANCH and _fetch(
        sibling, DEFAULT_BRANCH
    ):  # main reachable, so the branch is missing
        if warnings is not None:
            warnings.append(
                f"  {sibling.name} has no origin/{branch}: comparing against origin/{DEFAULT_BRANCH}"
            )
        return f"origin/{DEFAULT_BRANCH}"
    return None


def _target_names(target) -> list[str]:
    """Names bound by an assignment, loop or `with` target (tuple, list and starred unpacking included)."""
    if isinstance(target, ast.Name):
        return [target.id]
    if isinstance(target, (ast.Tuple, ast.List)):
        return [n for elt in target.elts for n in _target_names(elt)]
    if isinstance(target, ast.Starred):
        return _target_names(target.value)
    return []


def _module_statements(nodes):
    """Every statement executed at module scope, descending into if/try/with/for/while blocks but not into
    def/class bodies (the names those bind are not importable from the module)."""
    for node in nodes:
        yield node
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            continue
        for attr in ("body", "orelse", "finalbody"):
            block = getattr(node, attr, None)
            if isinstance(block, list):
                yield from _module_statements(block)
        if isinstance(node, ast.Try):
            for handler in node.handlers:
                yield from _module_statements(handler.body)


def _module_defines(nodes, name: str) -> bool:
    """True if `name` is bound at module-execution scope: def/class, plain, annotated or unpacked assignment,
    `import x [as y]`, `from m import x [as y]` (the static re-export), or a module-level loop/`with` target,
    including inside module-level if/try/with/for/while blocks (e.g. a conditional singleton
    `try: limiter = Limiter() except ...: limiter = _Shim()`)."""
    for node in _module_statements(nodes):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            if node.name == name:
                return True
        elif isinstance(node, ast.Assign):
            if any(name in _target_names(target) for target in node.targets):
                return True
        elif isinstance(node, ast.AnnAssign):
            if name in _target_names(node.target):
                return True
        elif isinstance(node, (ast.For, ast.AsyncFor)):
            if name in _target_names(node.target):
                return True
        elif isinstance(node, (ast.With, ast.AsyncWith)):
            if any(
                item.optional_vars is not None
                and name in _target_names(item.optional_vars)
                for item in node.items
            ):
                return True
        elif isinstance(node, ast.ImportFrom):
            if any((alias.asname or alias.name) == name for alias in node.names):
                return True
        elif isinstance(node, ast.Import):
            if any(
                (alias.asname or alias.name.split(".")[0]) == name
                for alias in node.names
            ):
                return True
    return False


def _string_items(node) -> list[str]:
    """String literals in a list/tuple/set display, or in a `+` of them (`__all__ = [...] + [...]`)."""
    if isinstance(node, (ast.List, ast.Tuple, ast.Set)):
        return [
            e.value
            for e in node.elts
            if isinstance(e, ast.Constant) and isinstance(e.value, str)
        ]
    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add):
        return _string_items(node.left) + _string_items(node.right)
    return []


def _container_keys(node) -> list[str]:
    """String keys of a dict display, else the string items of a list/tuple/set display."""
    if isinstance(node, ast.Dict):
        return [
            k.value
            for k in node.keys
            if isinstance(k, ast.Constant) and isinstance(k.value, str)
        ]
    return _string_items(node)


def _declared_all(nodes) -> set[str]:
    """Names listed in a module-level `__all__` (`=`, `+=`, `.extend([...])`, `.append("x")`), literals only."""
    out: set[str] = set()
    for node in _module_statements(nodes):
        if isinstance(node, ast.Assign):
            if any(isinstance(t, ast.Name) and t.id == "__all__" for t in node.targets):
                out.update(_string_items(node.value))
        elif isinstance(node, (ast.AugAssign, ast.AnnAssign)):
            if (
                isinstance(node.target, ast.Name)
                and node.target.id == "__all__"
                and node.value is not None
            ):
                out.update(_string_items(node.value))
        elif isinstance(node, ast.Expr) and isinstance(node.value, ast.Call):
            call = node.value
            func = call.func
            if (
                isinstance(func, ast.Attribute)
                and isinstance(func.value, ast.Name)
                and func.value.id == "__all__"
                and func.attr in ("extend", "append")
            ):
                for arg in call.args:
                    if isinstance(arg, ast.Constant) and isinstance(arg.value, str):
                        out.add(arg.value)
                    else:
                        out.update(_string_items(arg))
    return out


def _getattr_literals(nodes) -> set[str] | None:
    """Names a module-level `def __getattr__(name)` answers, read from the string literals its body compares the
    parameter with: `name == "x"`, `name in ("x", "y")`, `name in _LAZY` / `_LAZY[name]` / `_LAZY.get(name)` where
    `_LAZY` is a module-level dict, list, tuple or set of string literals. None when the module has no
    `__getattr__`. An empty set means the function is opaque (it delegates, imports by name, ...): nothing
    can be listed."""
    func = next(
        (
            n
            for n in _module_statements(nodes)
            if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))
            and n.name == "__getattr__"
        ),
        None,
    )
    if func is None:
        return None
    if not func.args.args:
        return set()
    param = func.args.args[0].arg
    containers: dict[str, list[str]] = {}
    for node in _module_statements(nodes):
        if (
            isinstance(node, ast.Assign)
            and len(node.targets) == 1
            and isinstance(node.targets[0], ast.Name)
        ):
            containers[node.targets[0].id] = _container_keys(node.value)
        elif (
            isinstance(node, ast.AnnAssign)
            and isinstance(node.target, ast.Name)
            and node.value is not None
        ):
            containers[node.target.id] = _container_keys(node.value)

    def is_param(n) -> bool:
        return isinstance(n, ast.Name) and n.id == param

    names: set[str] = set()
    for sub in ast.walk(func):
        if isinstance(sub, ast.Compare) and any(
            is_param(n) for n in (sub.left, *sub.comparators)
        ):
            for operand in (sub.left, *sub.comparators):
                if is_param(operand):
                    continue
                if isinstance(operand, ast.Constant) and isinstance(operand.value, str):
                    names.add(operand.value)
                elif isinstance(operand, ast.Name):
                    names.update(containers.get(operand.id, ()))
                else:
                    names.update(_container_keys(operand))
        elif (
            isinstance(sub, ast.Subscript)
            and is_param(sub.slice)
            and isinstance(sub.value, ast.Name)
        ):
            names.update(containers.get(sub.value.id, ()))
        elif (
            isinstance(sub, ast.Call)
            and isinstance(sub.func, ast.Attribute)
            and sub.func.attr in ("get", "pop")
            and isinstance(sub.func.value, ast.Name)
            and sub.args
            and is_param(sub.args[0])
        ):
            names.update(containers.get(sub.func.value.id, ()))
    return names


def _star_imports(nodes) -> list[tuple[str | None, int]]:
    """`(module, level)` of every module-scope `from m import *`."""
    return [
        (node.module, node.level)
        for node in _module_statements(nodes)
        if isinstance(node, ast.ImportFrom)
        and any(alias.name == "*" for alias in node.names)
    ]


def _star_target(
    parts: list[str], kind: str, module: str | None, level: int
) -> list[str] | None:
    """Dotted path (as parts) a `from <module> import *` at `level` dots in module `parts` (of `kind` package or
    module) refers to, None if it cannot be formed."""
    if level == 0:
        return module.split(".") if module else None
    base = list(parts) if kind == "package" else list(parts[:-1])
    if level - 1 > len(base):
        return None
    base = base[: len(base) - (level - 1)]
    return base + (module.split(".") if module else [])


def _origin_object_type(
    sibling: Path, relpath: str, ref: str = "origin/main"
) -> str | None:
    """Git object type of `relpath` in the sibling's `ref` tree (`blob` or `tree`), None if absent."""
    try:
        return run(
            ["git", "-C", str(sibling), "cat-file", "-t", f"{ref}:{relpath}"]
        ).strip()
    except subprocess.CalledProcessError:
        return None


def _dotted_kind(sibling: Path, parts: list[str], ref: str = "origin/main") -> str:
    """How Python resolves the dotted path on the sibling's `ref`: `package` (x/__init__.py), `module` (x.py),
    `namespace` (a directory x/ with no `__init__.py`) or `missing`. Per component the order is package, then module
    file, then namespace directory, so x.py shadows an x/ without `__init__.py`. A module has no children: any
    component below one is `missing`."""
    kind = "missing"
    for depth in range(1, len(parts) + 1):
        base = "/".join(parts[:depth])
        if _origin_object_type(sibling, base + "/__init__.py", ref) == "blob":
            kind = "package"
        elif _origin_object_type(sibling, base + ".py", ref) == "blob":
            kind = "module"
        elif _origin_object_type(sibling, base, ref) == "tree":
            kind = "namespace"
        else:
            return "missing"
        if kind == "module" and depth < len(parts):
            return "missing"
    return kind


MAX_STAR_MODULES = 16


def _lookup(
    sibling: Path,
    parts: list[str],
    name: str,
    ref: str,
    notes: list[str],
    seen: set[tuple[str, ...]],
    children: bool,
) -> bool | None:
    """`symbol_exists_at_origin` for the dotted path `parts`. `seen` guards star-import cycles; `children` is False
    when following a `from m import *` (a star import does not bring in submodules)."""
    kind = _dotted_kind(sibling, parts, ref)
    if kind == "missing":
        return None  # module not found at origin
    dotted = ".".join(parts)
    if kind != "namespace":  # a namespace package has no source to read
        key = tuple(parts)
        if key in seen:
            return False
        seen.add(key)
        relpath = "/".join(parts) + (".py" if kind == "module" else "/__init__.py")
        try:
            content = run(["git", "-C", str(sibling), "show", f"{ref}:{relpath}"])
            tree = ast.parse(content)
        except (SyntaxError, UnicodeDecodeError):
            return True  # parse failure: be lenient, let CI catch it
        if _module_defines(tree.body, name) or name in _declared_all(tree.body):
            return True
        dynamic = _getattr_literals(tree.body)  # names served by a module `__getattr__`
        if dynamic is not None:
            if name in dynamic:
                return True
            if not dynamic:
                notes.append(
                    f"  {dotted}@{ref}: its __getattr__ is opaque (no literal names), `{name}` accepted unverified"
                )
                return True
        for module, level in _star_imports(tree.body):
            target = _star_target(parts, kind, module, level)
            found = (
                None
                if target is None or len(seen) > MAX_STAR_MODULES
                else _lookup(sibling, target, name, ref, notes, seen, False)
            )
            if (
                found is None
            ):  # a star source outside the sibling (stdlib, third party) or too deep: unlistable
                notes.append(
                    f"  {dotted}@{ref}: `from {'.' * level}{module or ''} import *` cannot be resolved here, `{name}` accepted unverified"
                )
                return True
            if found and not name.startswith("_"):
                return True
    return (
        children
        and kind != "module"
        and _dotted_kind(sibling, parts + [name], ref) != "missing"
    )


def symbol_exists_at_origin(
    sibling: Path,
    module: str,
    name: str,
    ref: str = "origin/main",
    notes: list[str] | None = None,
) -> bool | None:
    """True if `name` is exported by `module`, or is a child (submodule, subpackage, namespace directory) of a
    package `module`, on the sibling's `ref`. Exported means: bound at module scope (def, class, assignment, import
    or re-export), listed in `__all__`, answered by a module `__getattr__` that names it in a literal, or brought in
    by a `from m import *` of a module that exports it. False if the module is there but has no such name, None if
    the module is not at `ref` at all. A module whose `__getattr__` or star import cannot be read statically accepts
    the name and appends one line to `notes` saying so (no silent degradation). Resolution follows Python's import
    precedence (`_dotted_kind`), so a file module is never searched for children."""
    return _lookup(
        sibling,
        module.split("."),
        name,
        ref,
        [] if notes is None else notes,
        set(),
        True,
    )


def validate_target(
    root: Path, branch: str, warnings: list[str], skipped: list[str]
) -> list[tuple[Path, str, str, Path, str]]:
    """Cross-repo imports of a push to `branch` that do not resolve on the sibling's matching branch."""
    changed = files_changed_in_push(root, own_base_ref(root, branch, warnings))
    failures: list[tuple[Path, str, str, Path, str]] = []
    if not changed:
        return failures  # nothing to validate

    for prefix, sib_relpath in SIBLING_REPOS.items():
        sibling = (root / sib_relpath).resolve()
        if not sibling.exists():
            skipped.append(f"  {prefix}: sibling not checked out at {sib_relpath}")
            continue
        sib_ref = fetch_origin(sibling, branch, warnings)
        if sib_ref is None:
            skipped.append(
                f"  {prefix}: could not fetch origin/{branch} from {sib_relpath} (offline?)"
            )
            continue

        for py_file in changed:
            for module, name in imports_from_file(py_file):
                if not module.split(".")[0] == prefix:
                    continue
                if (
                    symbol_exists_at_origin(sibling, module, name, sib_ref, warnings)
                    is not True
                ):  # False or None (module absent)
                    failures.append((py_file, module, name, sibling, sib_ref))
    return failures


def main(stdin_text: str | None = None) -> int:
    root = repo_root()
    warnings: list[str] = []
    skipped: list[str] = []
    failures: list[tuple[Path, str, str, Path, str]] = []
    for branch in target_branches(
        read_stdin() if stdin_text is None else stdin_text, warnings
    ):
        for failure in validate_target(root, branch, warnings, skipped):
            if failure not in failures:
                failures.append(failure)

    if warnings:
        print(
            "\n[pre-push] WARNING: fallback or unverified export (not a failure):",
            file=sys.stderr,
        )
        for line in dict.fromkeys(warnings):
            print(line, file=sys.stderr)

    if skipped:
        print("\n[pre-push] Cross-repo checks partially skipped:", file=sys.stderr)
        for line in dict.fromkeys(skipped):
            print(line, file=sys.stderr)

    if failures:
        print(
            "\n\033[31m[pre-push] BLOCKED: cross-repo imports will fail in CI\033[0m\n",
            file=sys.stderr,
        )
        print(
            "These imports reference symbols not yet on the push-target branch of sibling repos:\n",
            file=sys.stderr,
        )
        for py_file, module, name, sibling, sib_ref in failures:
            try:
                rel = py_file.relative_to(root)
            except ValueError:
                rel = py_file
            print(f"  {rel}", file=sys.stderr)
            print(f"    from {module} import {name}", file=sys.stderr)
            print(f"    └─ not found in {sibling.name}@{sib_ref}\n", file=sys.stderr)
        print(
            "Fix: push the sibling repo first, or revert the new dependency.",
            file=sys.stderr,
        )
        print("Bypass (last resort): git push --no-verify\n", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
